# --- Database ---
# POSTGRES_USER/PASSWORD/DB are the canonical credentials — docker-compose.yml
# derives the postgres container's env and the api's DATABASE_URL from these,
# so rotating the password here is enough (don't hardcode it elsewhere).
POSTGRES_USER=thoughtplanner
POSTGRES_PASSWORD=thoughtplanner
POSTGRES_DB=thoughtplanner
# Only used for bare/non-docker local dev; ignored by docker-compose.yml,
# which builds its own DATABASE_URL from POSTGRES_* above.
DATABASE_URL=postgresql://thoughtplanner:thoughtplanner@localhost:5432/thoughtplanner

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Better Auth ---
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Self-service sign-up is disabled by default once the workspace has an owner
# (the first account created is always allowed through and becomes ADMIN).
# Set to "true" only while you need to let another person register, then unset
# it again — there is no invite-token flow yet.
ALLOW_SIGNUP=false

# --- MinIO (file storage) ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=thoughtplanner
MINIO_SECRET_KEY=thoughtplanner-secret
MINIO_BUCKET=thoughtplanner
MINIO_USE_SSL=false
# Public URL for generating file links (set to https://<DOMAIN>:9000 on a VPS)
MINIO_PUBLIC_URL=http://localhost:9000

# --- API ---
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# --- Web (Next.js public env vars) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- VPS production only (docker-compose.prod.yml) ---
# Real domain name (not "localhost") — required for Caddy to obtain a Let's
# Encrypt certificate. Point DNS at this host and open ports 80/443/3001/9000
# before starting. See Caddyfile.prod.
DOMAIN=
# When DOMAIN is set, update the vars above to match:
#   BETTER_AUTH_URL=https://your-domain:3001
#   MINIO_PUBLIC_URL=https://your-domain:9000
#   CORS_ORIGIN=https://your-domain
#   NEXT_PUBLIC_API_URL=https://your-domain:3001
#   NEXT_PUBLIC_APP_URL=https://your-domain
