# --- Database ---
DATABASE_URL=postgresql://thoughtplanner:thoughtplanner@postgres:5432/thoughtplanner

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Better Auth ---
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001

# --- MinIO (file storage) ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=thoughtplanner
MINIO_SECRET_KEY=thoughtplanner-secret
MINIO_BUCKET=thoughtplanner
MINIO_USE_SSL=false
# Public URL for generating file links (set to your domain on VPS)
MINIO_PUBLIC_URL=http://localhost:9000

# --- API ---
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# --- Web (Next.js public env vars) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
