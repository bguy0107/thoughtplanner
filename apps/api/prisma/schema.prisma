generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ─── Auth (Better Auth managed tables) ────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(EDITOR)
  // Better Auth `admin` plugin fields — banned = deactivated (blocks login, revokes sessions).
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions            Session[]
  accounts            Account[]
  pagesCreated        Page[]            @relation("PageCreatedBy")
  pagesUpdated        Page[]            @relation("PageUpdatedBy")
  files               File[]
  apiKeys             ApiKey[]
  invitesCreated      Invite[]          @relation("InviteCreatedBy")
  inviteRedeemed      Invite[]          @relation("InviteRedeemedBy")
  workspaceMemberships WorkspaceMember[]
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  // Better Auth `admin` plugin field (impersonation) — unused, kept for schema compatibility.
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

// Singleton row (id is always 1) used to atomically claim "first user becomes
// site admin" during signup — see the INSERT ... ON CONFLICT in lib/auth.ts.
// A plain `count(User) === 0` check-then-act is racy under concurrent signups;
// this table lets Postgres's own unique-index insert serialize the claim.
model SystemState {
  id                Int     @id @default(1)
  firstAdminClaimed Boolean @default(false)
}

// ─── Workspaces ─────────────────────────────────────────────────────────────

enum WorkspaceRole {
  ADMIN
  EDITOR
  VIEWER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]
  pages   Page[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ─── Core content ─────────────────────────────────────────────────────────────

model Page {
  id           String   @id @default(cuid())
  workspaceId  String
  parentPageId String?
  title        String   @default("Untitled")
  icon         String?
  coverImage   String?
  // Full TipTap JSON document stored as JSONB
  content      Json?
  isDatabase   Boolean  @default(false)
  isFolder     Boolean  @default(false)
  isArchived   Boolean  @default(false)
  isPublic     Boolean  @default(false)
  // Fractional indexing for ordering siblings
  position     Float    @default(0)
  createdById  String
  updatedById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  parent     Page?  @relation("PageChildren", fields: [parentPageId], references: [id])
  children   Page[] @relation("PageChildren")
  createdBy  User   @relation("PageCreatedBy", fields: [createdById], references: [id])
  updatedBy  User   @relation("PageUpdatedBy", fields: [updatedById], references: [id])

  databaseSchema DatabaseSchema?
  databaseRows   DatabaseRow[]
  files          File[]

  @@index([parentPageId])
  @@index([isArchived, position])
  @@index([workspaceId, isArchived, position])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

model DatabaseSchema {
  id      String @id @default(cuid())
  pageId  String @unique
  // [{id, name, type: "text"|"number"|"checkbox"|"date"|"select"|"multi_select", options?: string[]}]
  columns Json

  page Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  rows DatabaseRow[]
}

model DatabaseRow {
  id         String @id @default(cuid())
  pageId     String
  schemaId   String
  // {columnId: value}
  properties Json   @default("{}")
  // Fractional-index-style ordering for drag-to-reorder, same convention as Page.position
  position   Float  @default(0)

  page   Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  schema DatabaseSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@index([pageId, position])
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  keyHash   String    @unique
  prefix    String
  createdAt DateTime  @default(now())
  lastUsed  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model File {
  id         String   @id @default(cuid())
  pageId     String
  uploaderId String
  filename   String
  mimeType   String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  page     Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([pageId])
}

// ─── Invites ────────────────────────────────────────────────────────────────

model Invite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  role        Role      @default(EDITOR)
  createdById String
  createdAt   DateTime  @default(now())
  usedAt      DateTime?
  usedById    String?

  createdBy User  @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteRedeemedBy", fields: [usedById], references: [id])

  @@index([email, usedAt])
}
